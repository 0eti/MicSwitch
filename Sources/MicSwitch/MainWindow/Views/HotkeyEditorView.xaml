<eye:SharedResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:eye="http://coderush.net/poeeye/"
                              xmlns:st="http://schemas.spicytaco.io/"
                              xmlns:viewModels="clr-namespace:MicSwitch.MainWindow.ViewModels">
    <DataTemplate DataType="{x:Type viewModels:HotkeyEditorViewModel}">
        <st:StackPanel Orientation="Horizontal" MarginBetweenChildren="5">
            <eye:HotKeyBox st:StackPanel.Fill="Fill" 
                           HotKey="{Binding Key}"
                           Background="Transparent" 
                           AcceptsTab="False" 
                           AcceptsReturn="False"
                           AcceptsMouseKeys="True">
                <eye:HotKeyBox.ToolTip>
                    <MultiBinding Converter="{StaticResource StringFormatConverter}"
                                  ConverterParameter="{}{0} 단축키 - Backspace, Delete, Esc로 초기화합니다. 해당 키를 더블클릭하면 단축키로 지정됩니다">
                        <Binding Path="Description"/>
                    </MultiBinding>
                </eye:HotKeyBox.ToolTip>
            </eye:HotKeyBox>
            <TextBlock Margin="10,0" Text="또는" FontWeight="Bold" />
            <eye:HotKeyBox st:StackPanel.Fill="Fill" 
                           HotKey="{Binding AlternativeKey}" Background="Transparent" 
                           AcceptsTab="False" 
                           AcceptsReturn="False"
                           AcceptsMouseKeys="True">
                <eye:HotKeyBox.ToolTip>
                    <MultiBinding Converter="{StaticResource StringFormatConverter}"
                                  ConverterParameter="{}{0} 보조 단축키 - Backspace, Delete, Esc로 초기화합니다. 해당 키를 더블클릭하면 단축키로 지정됩니다">
                        <Binding Path="Description"/>
                    </MultiBinding>
                </eye:HotKeyBox.ToolTip>
            </eye:HotKeyBox>
            <st:StackPanel Orientation="Vertical" MarginBetweenChildren="2.5">
                <CheckBox
                    Content="가로채기"
                    ToolTip="켜 두면 다른 프로그램은 이 단축키에 반응하지 않습니다. 마우스 버튼이나 특수 키에서는 동작하지 않을 수 있습니다"
                    IsChecked="{Binding SuppressKey, Mode=TwoWay}" />
                <CheckBox
                    IsEnabled="{Binding HasModifiers, Converter={StaticResource NotConverter}}"
                    Content="보조키 무시"
                    ToolTip="이 단축키에서는 Ctrl/Alt/Shift 상태를 무시합니다"
                    IsChecked="{Binding IgnoreModifiers}" />
            </st:StackPanel>
        </st:StackPanel>
    </DataTemplate>
</eye:SharedResourceDictionary> 